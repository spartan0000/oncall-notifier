# Postgres connection - the app builds the connection URL from these, and
# docker-compose.yml uses the same vars to create the matching role/database.
DB_USER=oncall
DB_PASS=oncall
DB_NAME=oncall
# Only needed if Postgres isn't on localhost:5432 (e.g. a remote dev DB).
# DB_HOST=localhost
# DB_PORT=5432

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+64xxxxxxxxx

# Set to "true" to skip actually sending SMS (logs only) while testing
DRY_RUN=true

# Roster used by seed.py - comma-separated, matched up by position.
# Do not commit your real names/numbers; only .env.example should be tracked.
SURGEON_NAMES=Dr A,Dr B,Dr C
SURGEON_NUMBERS=+64211234567,+64212345678,+64213456789
